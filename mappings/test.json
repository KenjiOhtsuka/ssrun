{
    "mappings": [
        {
            "request": {
                "method": "GET",
                "url": "/api/users/1"
            },
            "response": {
                "status": 200,
                "headers": {
                    "Content-Type": "application/json"
                },
                "body": "{ \"id\": 1, \"name\": \"Taro\" }"
            }
        },
        {
            "request": {
                "method": "POST",
                "url": "/login"
            },
            "response": {
                "status": 200,
                "jsonBody": {
                    "token": "abc123"
                }
            }
        },
        {
            "request": {
                "method": "GET",
                "url": "/profile",
                "headers": {
                    "Authorization": {
                        "equalTo": "Bearer abc123"
                    }
                }
            },
            "response": {
                "status": 201,
                "jsonBody": {
                    "name": "Taro",
                    "address": "Tokyo"
                }
            }

        }
    ]
}
