{
    "mappings": [
        {
            "request": {
                "method": "POST",
                "url": "/login",
                "bodyPatterns": [
                    { "matchesJsonPath": "$[?(@.username && @.password)]" }
                ]
            },
            "response": {
                "status": 200,
                "jsonBody": {
                    "token": "abc123",
                    "refreshToken": "refresh_xyz789",
                    "expiresIn": 3600,
                    "tokenType": "Bearer"
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "url": "/register"
            },
            "response": {
                "status": 201,
                "jsonBody": {
                    "id": 5,
                    "name": "NewUser",
                    "email": "new@example.com",
                    "token": "new_token_abc"
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "url": "/auth/refresh",
                "headers": {
                    "Authorization": { "matches": "^Bearer refresh_.*" }
                }
            },
            "response": {
                "status": 200,
                "jsonBody": {
                    "token": "new_abc123",
                    "expiresIn": 3600
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "url": "/logout",
                "headers": {
                    "Authorization": { "equalTo": "Bearer abc123" }
                }
            },
            "response": {
                "status": 200,
                "jsonBody": { "message": "Logged out successfully" }
            }
        }
    ]
}
