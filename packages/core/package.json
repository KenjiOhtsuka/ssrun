{
  "name": "@kenjiotsuka/ssrun",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ssrun": "dist/main.js"
  },
  "description": "Scenario & Suite Runner CLI — API testing framework",
